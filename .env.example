# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/quoteflow?retryWrites=true&w=majority

# Secret used to sign/verify JWT auth tokens. Use a long random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
